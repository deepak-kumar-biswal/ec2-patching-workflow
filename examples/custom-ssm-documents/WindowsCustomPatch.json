{
  "schemaVersion": "2.2",
  "description": "Custom Windows Patching Document with Pre/Post Operations",
  "parameters": {
    "Operation": {
      "type": "String",
      "description": "The update operation to perform on the instance",
      "allowedValues": [
        "Install",
        "Scan"
      ],
      "default": "Install"
    },
    "RebootOption": {
      "type": "String",
      "description": "Reboot behavior after a patch Install operation",
      "allowedValues": [
        "NoReboot",
        "RebootIfNeeded"
      ],
      "default": "RebootIfNeeded"
    },
    "IncludeKbs": {
      "type": "String",
      "description": "Comma-separated list of KBs to include (optional)",
      "default": "",
      "allowedPattern": "^$|^KB[0-9]{6,7}(,KB[0-9]{6,7})*$"
    },
    "ExcludeKbs": {
      "type": "String",
      "description": "Comma-separated list of KBs to exclude (optional)",
      "default": "",
      "allowedPattern": "^$|^KB[0-9]{6,7}(,KB[0-9]{6,7})*$"
    },
    "ServiceNames": {
      "type": "StringList",
      "description": "List of services to stop before patching",
      "default": [
        "MyCustomApp",
        "WebService"
      ]
    },
    "BackupLocation": {
      "type": "String",
      "description": "S3 location for configuration backups",
      "default": "s3://my-backup-bucket/windows-configs/"
    },
    "MaintenanceMode": {
      "type": "String",
      "description": "Enable maintenance mode notifications",
      "allowedValues": ["true", "false"],
      "default": "true"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runPowerShellScript",
      "name": "PrePatchValidation",
      "description": "Validate system state before patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "# Pre-patch validation script",
          "Write-Output \"Starting pre-patch validation...\"",
          "",
          "# Check disk space (minimum 2GB free)",
          "$diskSpace = Get-WmiObject -Class Win32_LogicalDisk -Filter \"DriveType=3\" | Where-Object {$_.DeviceLetter -eq 'C:'} | Select-Object @{Name='FreeSpaceGB';Expression={[math]::Round($_.FreeSpace/1GB,2)}}",
          "if ($diskSpace.FreeSpaceGB -lt 2) {",
          "    Write-Error \"Insufficient disk space: $($diskSpace.FreeSpaceGB)GB available. Minimum 2GB required.\"",
          "    exit 1",
          "}",
          "Write-Output \"Disk space check passed: $($diskSpace.FreeSpaceGB)GB available\"",
          "",
          "# Check if system is domain-joined and can communicate with DC",
          "try {",
          "    $domain = (Get-WmiObject Win32_ComputerSystem).Domain",
          "    if ($domain -ne 'WORKGROUP') {",
          "        $dcTest = Test-ComputerSecureChannel -Verbose",
          "        if (-not $dcTest) {",
          "            Write-Warning \"Domain trust relationship may be broken\"",
          "        } else {",
          "            Write-Output \"Domain connectivity verified: $domain\"",
          "        }",
          "    }",
          "} catch {",
          "    Write-Warning \"Could not verify domain status: $($_.Exception.Message)\"",
          "}",
          "",
          "# Check Windows Update service status",
          "$wuService = Get-Service -Name wuauserv",
          "if ($wuService.Status -ne 'Running') {",
          "    Write-Output \"Starting Windows Update service...\"",
          "    Start-Service -Name wuauserv",
          "    Start-Sleep -Seconds 10",
          "}",
          "",
          "# Check for pending reboot",
          "$pendingReboot = $false",
          "if (Get-ChildItem 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired' -ErrorAction SilentlyContinue) { $pendingReboot = $true }",
          "if (Get-Item 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\PostRebootReporting' -ErrorAction SilentlyContinue) { $pendingReboot = $true }",
          "if ($pendingReboot) {",
          "    Write-Warning \"System has pending reboot - patching may require additional reboot\"",
          "} else {",
          "    Write-Output \"No pending reboot detected\"",
          "}",
          "",
          "Write-Output \"Pre-patch validation completed successfully\""
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "PrePatchBackup",
      "description": "Backup critical configurations before patching",
      "inputs": {
        "timeoutSeconds": "600",
        "runCommand": [
          "# Pre-patch backup script",
          "Write-Output \"Starting pre-patch backup operations...\"",
          "",
          "$backupDir = \"C:\\PatchBackup\\$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
          "New-Item -Path $backupDir -ItemType Directory -Force | Out-Null",
          "",
          "# Backup registry keys",
          "Write-Output \"Backing up critical registry keys...\"",
          "reg export 'HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' \"$backupDir\\windows_version.reg\" /y",
          "reg export 'HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services' \"$backupDir\\services.reg\" /y",
          "",
          "# Backup IIS configuration (if IIS is installed)",
          "if (Get-WindowsFeature -Name IIS-WebServerRole | Where-Object {$_.InstallState -eq 'Installed'}) {",
          "    Write-Output \"Backing up IIS configuration...\"",
          "    & \"$env:windir\\system32\\inetsrv\\appcmd.exe\" backup \"PrePatch-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
          "}",
          "",
          "# Backup system info",
          "Write-Output \"Capturing system information...\"",
          "Get-ComputerInfo | Out-File \"$backupDir\\system_info.txt\"",
          "Get-HotFix | Sort-Object InstalledOn -Descending | Out-File \"$backupDir\\installed_patches.txt\"",
          "Get-Service | Out-File \"$backupDir\\services_status.txt\"",
          "",
          "# Create backup summary",
          "$backupSummary = @{",
          "    'BackupTime' = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'",
          "    'ComputerName' = $env:COMPUTERNAME",
          "    'BackupLocation' = $backupDir",
          "    'BackupSize' = [math]::Round((Get-ChildItem $backupDir -Recurse | Measure-Object -Property Length -Sum).Sum / 1MB, 2)",
          "}",
          "$backupSummary | ConvertTo-Json | Out-File \"$backupDir\\backup_summary.json\"",
          "",
          "Write-Output \"Backup completed. Location: $backupDir\"",
          "Write-Output \"Backup size: $($backupSummary.BackupSize) MB\""
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "StopServices",
      "description": "Stop specified services before patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "# Stop services script",
          "$servicesToStop = '{{ ServiceNames }}'.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' }",
          "",
          "if ($servicesToStop.Count -gt 0) {",
          "    Write-Output \"Stopping services before patching...\"",
          "    ",
          "    foreach ($serviceName in $servicesToStop) {",
          "        try {",
          "            $service = Get-Service -Name $serviceName -ErrorAction SilentlyContinue",
          "            if ($service) {",
          "                if ($service.Status -eq 'Running') {",
          "                    Write-Output \"Stopping service: $serviceName\"",
          "                    Stop-Service -Name $serviceName -Force -ErrorAction Stop",
          "                    ",
          "                    # Wait for service to stop",
          "                    $timeout = 30",
          "                    $counter = 0",
          "                    do {",
          "                        Start-Sleep -Seconds 2",
          "                        $service = Get-Service -Name $serviceName",
          "                        $counter += 2",
          "                    } while ($service.Status -ne 'Stopped' -and $counter -lt $timeout)",
          "                    ",
          "                    if ($service.Status -eq 'Stopped') {",
          "                        Write-Output \"Service $serviceName stopped successfully\"",
          "                    } else {",
          "                        Write-Warning \"Service $serviceName did not stop within timeout\"",
          "                    }",
          "                } else {",
          "                    Write-Output \"Service $serviceName is already stopped\"",
          "                }",
          "            } else {",
          "                Write-Warning \"Service $serviceName not found\"",
          "            }",
          "        } catch {",
          "            Write-Error \"Failed to stop service $serviceName`: $($_.Exception.Message)\"",
          "        }",
          "    }",
          "} else {",
          "    Write-Output \"No services specified to stop\"",
          "}"
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "MaintenanceMode",
      "description": "Enable maintenance mode if specified",
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "# Maintenance mode script",
          "$maintenanceMode = '{{ MaintenanceMode }}'",
          "",
          "if ($maintenanceMode -eq 'true') {",
          "    Write-Output \"Enabling maintenance mode...\"",
          "    ",
          "    # Create maintenance mode file",
          "    $maintenanceFile = 'C:\\maintenance_mode.txt'",
          "    \"Maintenance started at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')\" | Out-File $maintenanceFile",
          "    ",
          "    # Set HTTP response for load balancers (if IIS is running)",
          "    if (Get-Service -Name 'W3SVC' -ErrorAction SilentlyContinue | Where-Object {$_.Status -eq 'Running'}) {",
          "        try {",
          "            # Create maintenance page",
          "            $maintenancePage = @'",
          "<!DOCTYPE html>",
          "<html><head><title>Maintenance Mode</title></head>",
          "<body><h1>System Under Maintenance</h1>",
          "<p>This system is currently undergoing maintenance. Please try again later.</p>",
          "<p>Started: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')</p>",
          "</body></html>",
          "'@",
          "            $maintenancePage | Out-File 'C:\\inetpub\\wwwroot\\maintenance.html' -Force",
          "            Write-Output \"Maintenance page created\"",
          "        } catch {",
          "            Write-Warning \"Could not create maintenance page: $($_.Exception.Message)\"",
          "        }",
          "    }",
          "    ",
          "    Write-Output \"Maintenance mode enabled\"",
          "} else {",
          "    Write-Output \"Maintenance mode not requested\"",
          "}"
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "InstallPatches",
      "description": "Install Windows updates using custom logic",
      "inputs": {
        "timeoutSeconds": "3600",
        "runCommand": [
          "# Custom Windows Update Installation",
          "Write-Output \"Starting Windows Update installation...\"",
          "",
          "$operation = '{{ Operation }}'",
          "$rebootOption = '{{ RebootOption }}'",
          "$includeKbs = '{{ IncludeKbs }}'.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' }",
          "$excludeKbs = '{{ ExcludeKbs }}'.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' }",
          "",
          "# Install PSWindowsUpdate module if not present",
          "if (-not (Get-Module -ListAvailable -Name PSWindowsUpdate)) {",
          "    Write-Output \"Installing PSWindowsUpdate module...\"",
          "    try {",
          "        Install-PackageProvider -Name NuGet -MinimumVersion 2.8.5.201 -Force -Scope CurrentUser",
          "        Install-Module -Name PSWindowsUpdate -Force -Scope CurrentUser -AllowClobber",
          "    } catch {",
          "        Write-Warning \"Could not install PSWindowsUpdate module: $($_.Exception.Message)\"",
          "        Write-Output \"Falling back to native Windows Update API...\"",
          "    }",
          "}",
          "",
          "# Import the module",
          "Import-Module PSWindowsUpdate -ErrorAction SilentlyContinue",
          "",
          "if (Get-Module PSWindowsUpdate) {",
          "    Write-Output \"Using PSWindowsUpdate module for patching\"",
          "    ",
          "    # Build update criteria",
          "    $updateParams = @{",
          "        MicrosoftUpdate = $true",
          "        AcceptAll = $true",
          "        Verbose = $true",
          "    }",
          "    ",
          "    if ($operation -eq 'Scan') {",
          "        $updateParams.Add('Download', $false)",
          "        $updateParams.Add('Install', $false)",
          "    } else {",
          "        $updateParams.Add('Install', $true)",
          "        if ($rebootOption -eq 'NoReboot') {",
          "            $updateParams.Add('AutoReboot', $false)",
          "        }",
          "    }",
          "    ",
          "    # Apply KB filters if specified",
          "    if ($includeKbs.Count -gt 0) {",
          "        Write-Output \"Including specific KBs: $($includeKbs -join ', ')\"",
          "        $updateParams.Add('KBArticleID', $includeKbs)",
          "    }",
          "    ",
          "    if ($excludeKbs.Count -gt 0) {",
          "        Write-Output \"Excluding KBs: $($excludeKbs -join ', ')\"",
          "        $updateParams.Add('NotKBArticleID', $excludeKbs)",
          "    }",
          "    ",
          "    # Execute update operation",
          "    try {",
          "        $updateResult = Get-WindowsUpdate @updateParams",
          "        ",
          "        if ($updateResult) {",
          "            Write-Output \"Updates processed:\"",
          "            $updateResult | ForEach-Object {",
          "                Write-Output \"  - $($_.Title) (KB$($_.KBArticleIDs -join ',KB'))\"",
          "            }",
          "        } else {",
          "            Write-Output \"No updates found or all updates already installed\"",
          "        }",
          "    } catch {",
          "        Write-Error \"Update operation failed: $($_.Exception.Message)\"",
          "        exit 1",
          "    }",
          "} else {",
          "    Write-Output \"Using Windows Update API directly\"",
          "    ",
          "    # Fallback to COM-based Windows Update",
          "    try {",
          "        $updateSession = New-Object -ComObject Microsoft.Update.Session",
          "        $updateSearcher = $updateSession.CreateUpdateSearcher()",
          "        ",
          "        Write-Output \"Searching for updates...\"",
          "        $searchResult = $updateSearcher.Search(\"IsInstalled=0 and Type='Software'\")",
          "        ",
          "        if ($searchResult.Updates.Count -eq 0) {",
          "            Write-Output \"No updates available\"",
          "        } else {",
          "            Write-Output \"Found $($searchResult.Updates.Count) updates\"",
          "            ",
          "            if ($operation -eq 'Install') {",
          "                $updatesToInstall = New-Object -ComObject Microsoft.Update.UpdateColl",
          "                ",
          "                foreach ($update in $searchResult.Updates) {",
          "                    $shouldInclude = $true",
          "                    ",
          "                    # Apply KB filters",
          "                    if ($includeKbs.Count -gt 0) {",
          "                        $shouldInclude = $false",
          "                        foreach ($kb in $includeKbs) {",
          "                            if ($update.KBArticleIDs -contains $kb.Replace('KB','')) {",
          "                                $shouldInclude = $true",
          "                                break",
          "                            }",
          "                        }",
          "                    }",
          "                    ",
          "                    if ($excludeKbs.Count -gt 0) {",
          "                        foreach ($kb in $excludeKbs) {",
          "                            if ($update.KBArticleIDs -contains $kb.Replace('KB','')) {",
          "                                $shouldInclude = $false",
          "                                break",
          "                            }",
          "                        }",
          "                    }",
          "                    ",
          "                    if ($shouldInclude) {",
          "                        Write-Output \"Queuing: $($update.Title)\"",
          "                        $updatesToInstall.Add($update) | Out-Null",
          "                    }",
          "                }",
          "                ",
          "                if ($updatesToInstall.Count -gt 0) {",
          "                    $downloader = $updateSession.CreateUpdateDownloader()",
          "                    $downloader.Updates = $updatesToInstall",
          "                    $downloadResult = $downloader.Download()",
          "                    ",
          "                    $installer = $updateSession.CreateUpdateInstaller()",
          "                    $installer.Updates = $updatesToInstall",
          "                    $installResult = $installer.Install()",
          "                    ",
          "                    Write-Output \"Installation completed with result code: $($installResult.ResultCode)\"",
          "                }",
          "            }",
          "        }",
          "    } catch {",
          "        Write-Error \"Windows Update API operation failed: $($_.Exception.Message)\"",
          "        exit 1",
          "    }",
          "}",
          "",
          "Write-Output \"Patch installation phase completed\""
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "PostPatchValidation",
      "description": "Validate system state after patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "# Post-patch validation script",
          "Write-Output \"Starting post-patch validation...\"",
          "",
          "# Check for errors in Windows Update logs",
          "try {",
          "    $wuErrors = Get-WinEvent -FilterHashtable @{LogName='System'; Level=1,2; StartTime=(Get-Date).AddHours(-2)} -ErrorAction SilentlyContinue | Where-Object {$_.ProviderName -like '*WindowsUpdate*' -or $_.ProviderName -like '*WUAU*'}",
          "    if ($wuErrors) {",
          "        Write-Warning \"Found $($wuErrors.Count) Windows Update related errors in System log\"",
          "        $wuErrors | Select-Object TimeCreated, Id, LevelDisplayName, Message | Format-Table -AutoSize",
          "    } else {",
          "        Write-Output \"No recent Windows Update errors found in System log\"",
          "    }",
          "} catch {",
          "    Write-Warning \"Could not check Windows Update logs: $($_.Exception.Message)\"",
          "}",
          "",
          "# Check Windows Update service status",
          "$wuService = Get-Service -Name wuauserv",
          "Write-Output \"Windows Update service status: $($wuService.Status)\"",
          "",
          "# Check for pending reboot",
          "$rebootRequired = $false",
          "$rebootReasons = @()",
          "",
          "# Check various reboot indicators",
          "if (Get-ChildItem 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired' -ErrorAction SilentlyContinue) {",
          "    $rebootRequired = $true",
          "    $rebootReasons += 'Windows Update RebootRequired key'",
          "}",
          "",
          "if (Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue) {",
          "    $rebootRequired = $true",
          "    $rebootReasons += 'PendingFileRenameOperations'",
          "}",
          "",
          "if (Get-ChildItem 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Component Based Servicing\\RebootPending' -ErrorAction SilentlyContinue) {",
          "    $rebootRequired = $true",
          "    $rebootReasons += 'Component Based Servicing RebootPending'",
          "}",
          "",
          "if ($rebootRequired) {",
          "    Write-Output \"REBOOT REQUIRED - Reasons: $($rebootReasons -join ', ')\"",
          "} else {",
          "    Write-Output \"No reboot required\"",
          "}",
          "",
          "# Get latest installed updates",
          "Write-Output \"Recently installed updates:\"",
          "Get-HotFix | Where-Object {$_.InstalledOn -gt (Get-Date).AddDays(-1)} | Sort-Object InstalledOn -Descending | ForEach-Object {",
          "    Write-Output \"  - $($_.HotFixID): $($_.Description) (Installed: $($_.InstalledOn))\"",
          "}",
          "",
          "Write-Output \"Post-patch validation completed\""
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "RestartServices",  
      "description": "Restart previously stopped services",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "# Restart services script",
          "$servicesToRestart = '{{ ServiceNames }}'.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne '' }",
          "",
          "if ($servicesToRestart.Count -gt 0) {",
          "    Write-Output \"Restarting services after patching...\"",
          "    ",
          "    foreach ($serviceName in $servicesToRestart) {",
          "        try {",
          "            $service = Get-Service -Name $serviceName -ErrorAction SilentlyContinue", 
          "            if ($service) {",
          "                if ($service.Status -eq 'Stopped') {",
          "                    Write-Output \"Starting service: $serviceName\"",
          "                    Start-Service -Name $serviceName -ErrorAction Stop",
          "                    ",
          "                    # Wait for service to start",
          "                    $timeout = 60",
          "                    $counter = 0",
          "                    do {",
          "                        Start-Sleep -Seconds 2",
          "                        $service = Get-Service -Name $serviceName",
          "                        $counter += 2",
          "                    } while ($service.Status -ne 'Running' -and $counter -lt $timeout)",
          "                    ",
          "                    if ($service.Status -eq 'Running') {",
          "                        Write-Output \"Service $serviceName started successfully\"",
          "                    } else {",
          "                        Write-Error \"Service $serviceName failed to start within timeout\"",
          "                    }",
          "                } else {",
          "                    Write-Output \"Service $serviceName is already running\"",
          "                }",
          "            } else {",
          "                Write-Warning \"Service $serviceName not found\"",
          "            }",
          "        } catch {",
          "            Write-Error \"Failed to start service $serviceName`: $($_.Exception.Message)\"",
          "        }",
          "    }",
          "} else {",
          "    Write-Output \"No services specified to restart\"",
          "}"
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "DisableMaintenanceMode",
      "description": "Disable maintenance mode",
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "# Disable maintenance mode script",
          "$maintenanceMode = '{{ MaintenanceMode }}'",
          "",
          "if ($maintenanceMode -eq 'true') {",
          "    Write-Output \"Disabling maintenance mode...\"",
          "    ",
          "    # Remove maintenance mode file",
          "    $maintenanceFile = 'C:\\maintenance_mode.txt'",
          "    if (Test-Path $maintenanceFile) {",
          "        Remove-Item $maintenanceFile -Force",
          "        Write-Output \"Maintenance mode file removed\"",
          "    }",
          "    ",
          "    # Remove maintenance page",
          "    $maintenancePage = 'C:\\inetpub\\wwwroot\\maintenance.html'",
          "    if (Test-Path $maintenancePage) {",
          "        Remove-Item $maintenancePage -Force",
          "        Write-Output \"Maintenance page removed\"",
          "    }",
          "    ",
          "    Write-Output \"Maintenance mode disabled\"",
          "} else {",
          "    Write-Output \"Maintenance mode was not enabled\"",
          "}"
        ]
      }
    },
    {
      "action": "aws:runPowerShellScript",
      "name": "GenerateReport",
      "description": "Generate patching report",
      "inputs": {
        "timeoutSeconds": "180",
        "runCommand": [
          "# Generate patching report",
          "Write-Output \"Generating patching report...\"",
          "",
          "$reportData = @{",
          "    'ComputerName' = $env:COMPUTERNAME",
          "    'PatchingDate' = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'",
          "    'Operation' = '{{ Operation }}'",
          "    'RebootOption' = '{{ RebootOption }}'",
          "    'OSVersion' = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion').ProductName",
          "    'BuildNumber' = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion').CurrentBuild",
          "}",
          "",
          "# Get reboot status",
          "$rebootRequired = $false",
          "if (Get-ChildItem 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired' -ErrorAction SilentlyContinue) {",
          "    $rebootRequired = $true",
          "}",
          "$reportData.RebootRequired = $rebootRequired",
          "",
          "# Get installed updates from today",
          "$todayUpdates = Get-HotFix | Where-Object {$_.InstalledOn -gt (Get-Date).Date}",
          "$reportData.UpdatesInstalled = $todayUpdates.Count",
          "$reportData.UpdateDetails = $todayUpdates | Select-Object HotFixID, Description, InstalledOn",
          "",
          "# Get system health",
          "$reportData.ServicesRunning = (Get-Service | Where-Object {$_.Status -eq 'Running'}).Count",
          "$reportData.ServicesTotal = (Get-Service).Count",
          "",
          "# Save report",
          "$reportJson = $reportData | ConvertTo-Json -Depth 3",
          "Write-Output \"PATCHING_REPORT_START\"",
          "Write-Output $reportJson",
          "Write-Output \"PATCHING_REPORT_END\"",
          "",
          "Write-Output \"Patching report generated successfully\"",
          "Write-Output \"Summary: $($reportData.UpdatesInstalled) updates installed, Reboot required: $rebootRequired\""
        ]
      }
    }
  ]
}