{
  "schemaVersion": "2.2",
  "description": "Linux Post-Patch Operations - Service Restart and Validation",
  "parameters": {
    "ServiceNames": {
      "type": "StringList", 
      "description": "List of services to restart after patching",
      "default": ["httpd", "nginx", "postgresql", "myapp"]
    },
    "ValidateServices": {
      "type": "String",
      "description": "Validate service functionality", 
      "allowedValues": ["true", "false"],
      "default": "true"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "RestartAndValidate",
      "inputs": {
        "timeoutSeconds": "600",
        "runCommand": [
          "#!/bin/bash", 
          "set -e",
          "",
          "echo 'Starting post-patch operations...'",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "# Restart services from stopped list if it exists",
          "if [ -f /tmp/stopped_services.txt ]; then",
          "    log 'Restarting previously stopped services...'",
          "    while IFS= read -r service; do",
          "        if [ -n \"$service\" ]; then",
          "            log \"Starting service: $service\"",
          "            if systemctl start \"$service\"; then",
          "                log \"Service $service started successfully\"",
          "            else",
          "                log \"ERROR: Failed to start service $service\"",
          "            fi",
          "        fi",
          "    done < /tmp/stopped_services.txt",
          "    rm -f /tmp/stopped_services.txt",
          "else",
          "    # Fallback to parameter list",
          "    IFS=',' read -ra SERVICES <<< '{{ ServiceNames }}'",
          "    for service in \"${SERVICES[@]}\"; do",
          "        service=$(echo \"$service\" | xargs)",
          "        if systemctl list-unit-files --type=service | grep -q \"^$service.service\"; then",
          "            if ! systemctl is-active --quiet \"$service\"; then",
          "                log \"Starting service: $service\"",
          "                systemctl start \"$service\" || log \"WARNING: Failed to start $service\"",
          "            fi",
          "        fi",
          "    done",
          "fi",
          "",
          "# Validate services if requested",
          "if [ '{{ ValidateServices }}' = 'true' ]; then",
          "    log 'Validating services...'",
          "    ",
          "    # Test Apache/httpd if running",
          "    if systemctl is-active --quiet httpd 2>/dev/null || systemctl is-active --quiet apache2 2>/dev/null; then",
          "        if curl -s -o /dev/null -w '%{http_code}' http://localhost --connect-timeout 10 | grep -q '200\\|301\\|302'; then",
          "            log 'Apache validation: HTTP service responding'",
          "        else",
          "            log 'WARNING: Apache validation failed'",
          "        fi",
          "    fi",
          "    ",
          "    # Test Nginx if running", 
          "    if systemctl is-active --quiet nginx 2>/dev/null; then",
          "        if curl -s -o /dev/null -w '%{http_code}' http://localhost:80 --connect-timeout 10 | grep -q '200\\|301\\|302'; then",
          "            log 'Nginx validation: HTTP service responding'",
          "        else",
          "            log 'WARNING: Nginx validation failed'",
          "        fi",
          "    fi",
          "    ",
          "    # Test PostgreSQL if running",
          "    if systemctl is-active --quiet postgresql 2>/dev/null; then",
          "        if sudo -u postgres psql -c 'SELECT version();' >/dev/null 2>&1; then",
          "            log 'PostgreSQL validation: Database responding'",
          "        else",
          "            log 'WARNING: PostgreSQL validation failed'",
          "        fi",
          "    fi",
          "    ",
          "    # Test MySQL/MariaDB if running",
          "    if systemctl is-active --quiet mysqld 2>/dev/null || systemctl is-active --quiet mariadb 2>/dev/null; then",
          "        if mysql -e 'SELECT 1;' >/dev/null 2>&1; then",
          "            log 'MySQL/MariaDB validation: Database responding'",
          "        else",
          "            log 'WARNING: MySQL/MariaDB validation failed'",
          "        fi",
          "    fi",
          "fi",
          "",
          "# Check for reboot requirement",
          "if [ -f /var/run/reboot-required ]; then",
          "    log 'REBOOT REQUIRED'",
          "    cat /var/run/reboot-required",
          "else",
          "    # Check for kernel updates on RHEL/CentOS",
          "    current_kernel=$(uname -r)",
          "    if command -v rpm >/dev/null 2>&1; then",
          "        if rpm -q kernel | tail -1 | grep -v \"$current_kernel\" >/dev/null 2>&1; then",
          "            log 'REBOOT REQUIRED - New kernel installed'",
          "        else",
          "            log 'No reboot required'",
          "        fi",
          "    else",
          "        log 'No reboot required'",
          "    fi",
          "fi",
          "",
          "# Check system health",
          "log 'System health check:'",
          "log \"Load average: $(uptime | awk -F'load average:' '{print $2}')\"",
          "log \"Memory usage: $(free -m | grep Mem | awk '{printf \"%.1f%%\", $3/$2 * 100.0}')\"",
          "log \"Disk usage: $(df -h / | tail -1 | awk '{print $5}')\"",
          "",
          "# Count failed services",
          "failed_services=$(systemctl list-units --failed --no-legend | wc -l)",
          "if [ \"$failed_services\" -gt 0 ]; then",
          "    log \"WARNING: $failed_services failed services detected\"",
          "    systemctl list-units --failed --no-legend",
          "else",
          "    log 'No failed services detected'",
          "fi",
          "",
          "log 'Post-patch operations completed successfully'"
        ]
      }
    }
  ]
}