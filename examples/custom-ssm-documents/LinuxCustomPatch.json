{
  "schemaVersion": "2.2",
  "description": "Custom Linux Patching Document with Pre/Post Operations",
  "parameters": {
    "Operation": {
      "type": "String",
      "description": "The update operation to perform on the instance",
      "allowedValues": [
        "Install",
        "Scan"
      ],
      "default": "Install"
    },
    "RebootOption": {
      "type": "String",
      "description": "Reboot behavior after a patch Install operation",
      "allowedValues": [
        "NoReboot",
        "RebootIfNeeded"
      ],
      "default": "RebootIfNeeded"
    },
    "PackageIncludeFilter": {
      "type": "String",
      "description": "Space-separated list of package patterns to include (optional)",
      "default": "",
      "allowedPattern": "^$|^[a-zA-Z0-9*._+-]+(\\s+[a-zA-Z0-9*._+-]+)*$"
    },
    "PackageExcludeFilter": {
      "type": "String", 
      "description": "Space-separated list of package patterns to exclude (optional)",
      "default": "kernel* *-devel",
      "allowedPattern": "^$|^[a-zA-Z0-9*._+-]+(\\s+[a-zA-Z0-9*._+-]+)*$"
    },
    "ServiceNames": {
      "type": "StringList",
      "description": "List of services to stop before patching",
      "default": [
        "httpd",
        "nginx",
        "myapp"
      ]
    },
    "BackupLocation": {
      "type": "String",
      "description": "Local directory for configuration backups",
      "default": "/var/backups/pre-patch"
    },
    "MaintenanceMode": {
      "type": "String",
      "description": "Enable maintenance mode (create maintenance files)",
      "allowedValues": ["true", "false"],
      "default": "true"
    },
    "SecurityUpdatesOnly": {
      "type": "String",
      "description": "Install security updates only",
      "allowedValues": ["true", "false"],
      "default": "false"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "PrePatchValidation",
      "description": "Validate system state before patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Starting pre-patch validation...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "log \"Pre-patch validation initiated\"",
          "",
          "# Check disk space (minimum 1GB free on root and /var)",
          "check_disk_space() {",
          "    local path=$1",
          "    local min_space_mb=$2",
          "    ",
          "    if [ ! -d \"$path\" ]; then",
          "        log \"WARNING: Path $path does not exist\"",
          "        return 0",
          "    fi",
          "    ",
          "    local available_mb=$(df -m \"$path\" | awk 'NR==2 {print $4}')",
          "    log \"Available space on $path: ${available_mb}MB\"",
          "    ",
          "    if [ \"$available_mb\" -lt \"$min_space_mb\" ]; then",
          "        log \"ERROR: Insufficient disk space on $path. Available: ${available_mb}MB, Required: ${min_space_mb}MB\"",
          "        exit 1",
          "    fi",
          "    ",
          "    log \"Disk space check passed for $path\"",
          "}",
          "",
          "check_disk_space \"/\" 1024",
          "check_disk_space \"/var\" 512",
          "",
          "# Check system load",
          "load_avg=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//')",
          "load_threshold=5.0",
          "if (( $(echo \"$load_avg > $load_threshold\" | bc -l) )); then",
          "    log \"WARNING: High system load detected: $load_avg\"",
          "else",
          "    log \"System load is normal: $load_avg\"",
          "fi",
          "",
          "# Check if system is responsive",
          "log \"Testing system responsiveness...\"",
          "if ! timeout 10 ls /proc/loadavg > /dev/null 2>&1; then",
          "    log \"ERROR: System appears unresponsive\"",
          "    exit 1",
          "fi",
          "",
          "# Check package manager lock",
          "check_package_manager() {",
          "    if command -v yum >/dev/null 2>&1; then",
          "        log \"Checking yum lock status...\"",
          "        if pgrep -f yum >/dev/null; then",
          "            log \"WARNING: yum process is running\"",
          "            ps aux | grep yum | grep -v grep",
          "        fi",
          "    fi",
          "    ",
          "    if command -v apt-get >/dev/null 2>&1; then",
          "        log \"Checking apt lock status...\"",
          "        if lsof /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then",
          "            log \"WARNING: apt lock is held\"",
          "            lsof /var/lib/dpkg/lock-frontend",
          "        fi",
          "    fi",
          "    ",
          "    if command -v zypper >/dev/null 2>&1; then",
          "        log \"Checking zypper lock status...\"",
          "        if pgrep -f zypper >/dev/null; then",
          "            log \"WARNING: zypper process is running\"",
          "            ps aux | grep zypper | grep -v grep",
          "        fi",
          "    fi",
          "}",
          "",
          "check_package_manager",
          "",
          "# Check for pending kernel updates that require reboot",
          "if [ -f /var/run/reboot-required ]; then",
          "    log \"WARNING: System has pending reboot from previous operations\"",
          "    cat /var/run/reboot-required",
          "fi",
          "",
          "# Check critical services status",
          "log \"Checking critical system services...\"",
          "critical_services=(\"sshd\" \"systemd-logind\" \"dbus\")",
          "for service in \"${critical_services[@]}\"; do",
          "    if systemctl is-active --quiet \"$service\" 2>/dev/null; then",
          "        log \"Service $service is running\"",
          "    else",
          "        log \"WARNING: Critical service $service is not running\"",
          "    fi",
          "done",
          "",
          "# Check network connectivity",
          "log \"Testing network connectivity...\"",
          "if ping -c 1 -W 5 8.8.8.8 >/dev/null 2>&1; then",
          "    log \"Network connectivity verified\"",
          "else",
          "    log \"WARNING: Network connectivity issues detected\"",
          "fi",
          "",
          "# Check memory usage",
          "mem_usage=$(free | grep Mem | awk '{printf \"%.1f\", $3/$2 * 100.0}')",
          "log \"Current memory usage: ${mem_usage}%\"",
          "if (( $(echo \"$mem_usage > 90\" | bc -l) )); then",
          "    log \"WARNING: High memory usage detected\"",
          "fi",
          "",
          "log \"Pre-patch validation completed successfully\"",
          "echo \"VALIDATION_STATUS=PASSED\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "PrePatchBackup",
      "description": "Backup critical configurations before patching",
      "inputs": {
        "timeoutSeconds": "600",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Starting pre-patch backup operations...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "BACKUP_DIR=\"{{ BackupLocation }}/$(date +%Y%m%d-%H%M%S)\"",
          "mkdir -p \"$BACKUP_DIR\"",
          "",
          "log \"Backup directory created: $BACKUP_DIR\"",
          "",
          "# Backup package information",
          "log \"Backing up package information...\"",
          "if command -v rpm >/dev/null 2>&1; then",
          "    rpm -qa | sort > \"$BACKUP_DIR/installed_packages.txt\"",
          "elif command -v dpkg >/dev/null 2>&1; then",
          "    dpkg -l > \"$BACKUP_DIR/installed_packages.txt\"",
          "elif command -v zypper >/dev/null 2>&1; then",
          "    zypper se --installed-only > \"$BACKUP_DIR/installed_packages.txt\"",
          "fi",
          "",
          "# Backup system information",
          "log \"Capturing system information...\"",
          "uname -a > \"$BACKUP_DIR/system_info.txt\"",
          "uptime >> \"$BACKUP_DIR/system_info.txt\"",
          "free -h >> \"$BACKUP_DIR/system_info.txt\"",
          "df -h >> \"$BACKUP_DIR/system_info.txt\"",
          "",
          "# Backup kernel information",
          "log \"Backing up kernel information...\"",
          "uname -r > \"$BACKUP_DIR/current_kernel.txt\"",
          "if [ -d /boot ]; then",
          "    ls -la /boot/vmlinuz* > \"$BACKUP_DIR/available_kernels.txt\" 2>/dev/null || true",
          "fi",
          "",
          "# Backup service status",
          "log \"Backing up service status...\"",
          "if command -v systemctl >/dev/null 2>&1; then",
          "    systemctl list-units --type=service --state=running > \"$BACKUP_DIR/running_services.txt\"",
          "    systemctl list-units --type=service --state=failed > \"$BACKUP_DIR/failed_services.txt\"",
          "else",
          "    service --status-all > \"$BACKUP_DIR/service_status.txt\" 2>&1 || true",
          "fi",
          "",
          "# Backup network configuration",
          "log \"Backing up network configuration...\"",
          "ip addr show > \"$BACKUP_DIR/network_interfaces.txt\"",
          "ip route show > \"$BACKUP_DIR/routing_table.txt\"",
          "if [ -f /etc/resolv.conf ]; then",
          "    cp /etc/resolv.conf \"$BACKUP_DIR/resolv.conf.bak\"",
          "fi",
          "",
          "# Backup important configuration files",
          "log \"Backing up configuration files...\"",
          "config_files=()",
          "config_files+=(\"/etc/hosts\")",
          "config_files+=(\"/etc/hostname\")", 
          "config_files+=(\"/etc/fstab\")",
          "config_files+=(\"/etc/crontab\")",
          "config_files+=(\"/etc/ssh/sshd_config\")",
          "",
          "for config_file in \"${config_files[@]}\"; do",
          "    if [ -f \"$config_file\" ]; then",
          "        cp \"$config_file\" \"$BACKUP_DIR/$(basename $config_file).bak\"",
          "        log \"Backed up $config_file\"",
          "    fi",
          "done",
          "",
          "# Backup custom application configs (if they exist)",
          "if [ -d /etc/httpd ]; then",
          "    mkdir -p \"$BACKUP_DIR/httpd\"",
          "    cp -r /etc/httpd/* \"$BACKUP_DIR/httpd/\" 2>/dev/null || true",
          "    log \"Backed up Apache configuration\"",
          "fi",
          "",
          "if [ -d /etc/nginx ]; then",
          "    mkdir -p \"$BACKUP_DIR/nginx\"",
          "    cp -r /etc/nginx/* \"$BACKUP_DIR/nginx/\" 2>/dev/null || true",
          "    log \"Backed up Nginx configuration\"",
          "fi",
          "",
          "# Create backup summary",
          "cat > \"$BACKUP_DIR/backup_summary.json\" << EOF",
          "{",
          "  \"backup_time\": \"$(date -Iseconds)\",",
          "  \"hostname\": \"$(hostname)\",",
          "  \"backup_location\": \"$BACKUP_DIR\",",
          "  \"backup_size_kb\": $(du -sk \"$BACKUP_DIR\" | cut -f1),",
          "  \"kernel_version\": \"$(uname -r)\",",
          "  \"os_release\": \"$(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')\"",
          "}",
          "EOF",
          "",
          "backup_size=$(du -sh \"$BACKUP_DIR\" | cut -f1)",
          "log \"Backup completed. Location: $BACKUP_DIR\"",
          "log \"Backup size: $backup_size\"",
          "",
          "echo \"BACKUP_LOCATION=$BACKUP_DIR\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "StopServices",
      "description": "Stop specified services before patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Stopping services before patching...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "# Parse service names from parameter",
          "IFS=',' read -ra SERVICES <<< \"{{ ServiceNames }}\"",
          "",
          "if [ ${#SERVICES[@]} -eq 0 ]; then",
          "    log \"No services specified to stop\"",
          "    exit 0",
          "fi",
          "",
          "# Create array to track stopped services",
          "declare -a stopped_services",
          "",
          "for service_name in \"${SERVICES[@]}\"; do",
          "    # Trim whitespace",
          "    service_name=$(echo \"$service_name\" | xargs)",
          "    ",
          "    if [ -z \"$service_name\" ]; then",
          "        continue",
          "    fi",
          "    ",
          "    log \"Processing service: $service_name\"",
          "    ",
          "    # Check if service exists and is active",
          "    if systemctl is-active --quiet \"$service_name\" 2>/dev/null; then",
          "        log \"Stopping service: $service_name\"",
          "        ",
          "        if systemctl stop \"$service_name\"; then",
          "            # Wait for service to stop completely",
          "            timeout=30",
          "            counter=0",
          "            while systemctl is-active --quiet \"$service_name\" 2>/dev/null && [ $counter -lt $timeout ]; do",
          "                sleep 1",
          "                counter=$((counter + 1))",
          "            done",
          "            ",
          "            if systemctl is-active --quiet \"$service_name\" 2>/dev/null; then",
          "                log \"WARNING: Service $service_name did not stop within timeout\"",
          "            else",
          "                log \"Service $service_name stopped successfully\"",
          "                stopped_services+=(\"$service_name\")",
          "            fi",
          "        else",
          "            log \"ERROR: Failed to stop service $service_name\"",
          "        fi",
          "    elif systemctl list-unit-files --type=service | grep -q \"^$service_name.service\"; then",
          "        if systemctl is-active --quiet \"$service_name\" 2>/dev/null; then",
          "            log \"Service $service_name is already stopped\"",
          "        else",
          "            log \"Service $service_name exists but is not active\"",
          "        fi",
          "    else",
          "        log \"WARNING: Service $service_name not found\"",
          "    fi",
          "done",
          "",
          "# Save list of stopped services for restart later",
          "if [ ${#stopped_services[@]} -gt 0 ]; then",
          "    printf '%s\\n' \"${stopped_services[@]}\" > /tmp/stopped_services.txt",
          "    log \"Saved list of stopped services to /tmp/stopped_services.txt\"",
          "fi",
          "",
          "log \"Service stop operations completed\"",
          "echo \"STOPPED_SERVICES=${#stopped_services[@]}\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "MaintenanceMode",
      "description": "Enable maintenance mode if specified",
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Configuring maintenance mode...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "MAINTENANCE_MODE=\"{{ MaintenanceMode }}\"",
          "",
          "if [ \"$MAINTENANCE_MODE\" = \"true\" ]; then",
          "    log \"Enabling maintenance mode...\"",
          "    ",
          "    # Create maintenance mode file",
          "    echo \"Maintenance started at $(date -Iseconds)\" > /tmp/maintenance_mode",
          "    echo \"Host: $(hostname)\" >> /tmp/maintenance_mode",
          "    echo \"Process: EC2 Patching\" >> /tmp/maintenance_mode",
          "    ",
          "    # Create maintenance page for web servers",
          "    MAINTENANCE_HTML='/tmp/maintenance.html'",
          "    cat > \"$MAINTENANCE_HTML\" << 'EOF'",
          "<!DOCTYPE html>",
          "<html>",
          "<head>",
          "    <title>System Maintenance</title>",
          "    <meta http-equiv=\"refresh\" content=\"30\">",
          "</head>",
          "<body>",
          "    <h1>System Under Maintenance</h1>",
          "    <p>This system is currently undergoing maintenance. Please try again later.</p>",
          "    <p>Expected completion: Within 1 hour</p>",
          "    <p>Started: $(date)</p>",
          "</body>",
          "</html>",
          "EOF",
          "    ",
          "    # Copy maintenance page to web directories if they exist",
          "    web_dirs=(\"/var/www/html\" \"/usr/share/nginx/html\" \"/var/www\")",
          "    for web_dir in \"${web_dirs[@]}\"; do",
          "        if [ -d \"$web_dir\" ] && [ -w \"$web_dir\" ]; then",
          "            cp \"$MAINTENANCE_HTML\" \"$web_dir/maintenance.html\"",
          "            log \"Maintenance page created in $web_dir\"",
          "        fi",
          "    done",
          "    ",
          "    # Set up simple HTTP responder for load balancer health checks",
          "    # This creates a simple script that can respond to health checks",
          "    cat > /tmp/maintenance_responder.sh << 'EOF'",
          "#!/bin/bash",
          "# Simple maintenance mode responder",
          "while [ -f /tmp/maintenance_mode ]; do",
          "    echo \"HTTP/1.1 503 Service Unavailable\"",
          "    echo \"Content-Type: text/plain\"",
          "    echo \"\"",
          "    echo \"Service temporarily unavailable - maintenance in progress\"",
          "    sleep 1",
          "done",
          "EOF",
          "    chmod +x /tmp/maintenance_responder.sh",
          "    ",
          "    log \"Maintenance mode enabled\"",
          "    log \"Maintenance files created:\"",
          "    log \"  - /tmp/maintenance_mode\"",
          "    log \"  - /tmp/maintenance.html\"",
          "    log \"  - /tmp/maintenance_responder.sh\"",
          "else",
          "    log \"Maintenance mode not requested\"",
          "fi",
          "",
          "echo \"MAINTENANCE_MODE=$MAINTENANCE_MODE\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "InstallPatches",
      "description": "Install Linux updates using package manager",
      "inputs": {
        "timeoutSeconds": "3600",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Starting Linux package update installation...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "# Parse parameters",
          "OPERATION=\"{{ Operation }}\"",
          "REBOOT_OPTION=\"{{ RebootOption }}\"",
          "INCLUDE_FILTER=\"{{ PackageIncludeFilter }}\"",
          "EXCLUDE_FILTER=\"{{ PackageExcludeFilter }}\"",
          "SECURITY_ONLY=\"{{ SecurityUpdatesOnly }}\"",
          "",
          "log \"Operation: $OPERATION\"",
          "log \"Reboot Option: $REBOOT_OPTION\"",
          "log \"Security Only: $SECURITY_ONLY\"",
          "",
          "# Detect package manager",
          "detect_package_manager() {",
          "    if command -v yum >/dev/null 2>&1; then",
          "        echo \"yum\"",
          "    elif command -v dnf >/dev/null 2>&1; then",
          "        echo \"dnf\"",
          "    elif command -v apt-get >/dev/null 2>&1; then",
          "        echo \"apt\"",
          "    elif command -v zypper >/dev/null 2>&1; then",
          "        echo \"zypper\"",
          "    else",
          "        echo \"unknown\"",
          "    fi",
          "}",
          "",
          "PKG_MANAGER=$(detect_package_manager)",
          "log \"Detected package manager: $PKG_MANAGER\"",
          "",
          "if [ \"$PKG_MANAGER\" = \"unknown\" ]; then",
          "    log \"ERROR: No supported package manager found\"",
          "    exit 1",
          "fi",
          "",
          "# Update package cache/metadata",
          "update_package_cache() {",
          "    log \"Updating package cache...\"",
          "    case $PKG_MANAGER in",
          "        \"yum\")",
          "            yum clean all",
          "            yum makecache",
          "            ;;",
          "        \"dnf\")",
          "            dnf clean all",
          "            dnf makecache",
          "            ;;",
          "        \"apt\")",
          "            export DEBIAN_FRONTEND=noninteractive",
          "            apt-get update",
          "            ;;",
          "        \"zypper\")",
          "            zypper refresh",
          "            ;;",
          "    esac",
          "}",
          "",
          "# List available updates",
          "list_updates() {",
          "    log \"Checking for available updates...\"",
          "    case $PKG_MANAGER in",
          "        \"yum\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                yum --security check-update || true",
          "            else",
          "                yum check-update || true",
          "            fi",
          "            ;;",
          "        \"dnf\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                dnf --security check-update || true",
          "            else",
          "                dnf check-update || true",
          "            fi",
          "            ;;",
          "        \"apt\")",
          "            apt list --upgradable",
          "            ;;",
          "        \"zypper\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                zypper list-patches --category security",
          "            else",
          "                zypper list-updates",
          "            fi",
          "            ;;",
          "    esac",
          "}",
          "",
          "# Install updates",
          "install_updates() {",
          "    log \"Installing updates...\"",
          "    ",
          "    # Build exclude options",
          "    exclude_opts=\"\"",
          "    if [ -n \"$EXCLUDE_FILTER\" ]; then",
          "        log \"Applying exclude filter: $EXCLUDE_FILTER\"",
          "        case $PKG_MANAGER in",
          "            \"yum\"|\"dnf\")",
          "                for pkg in $EXCLUDE_FILTER; do",
          "                    exclude_opts=\"$exclude_opts --exclude=$pkg\"",
          "                done",
          "                ;;",
          "            \"apt\")",
          "                # APT handles excludes differently - mark packages as held",
          "                for pkg in $EXCLUDE_FILTER; do",
          "                    apt-mark hold \"$pkg\" 2>/dev/null || true",
          "                done",
          "                ;;",
          "            \"zypper\")",
          "                for pkg in $EXCLUDE_FILTER; do",
          "                    exclude_opts=\"$exclude_opts --exclude=$pkg\"",
          "                done",
          "                ;;",
          "        esac",
          "    fi",
          "    ",
          "    # Execute update command",
          "    case $PKG_MANAGER in",
          "        \"yum\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                yum -y --security update $exclude_opts",
          "            else",
          "                yum -y update $exclude_opts",
          "            fi",
          "            ;;",
          "        \"dnf\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                dnf -y --security update $exclude_opts",
          "            else",
          "                dnf -y update $exclude_opts",
          "            fi",
          "            ;;",
          "        \"apt\")",
          "            export DEBIAN_FRONTEND=noninteractive",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                unattended-upgrade -d || apt-get -y upgrade",
          "            else",
          "                apt-get -y upgrade",
          "            fi",
          "            ;;",
          "        \"zypper\")",
          "            if [ \"$SECURITY_ONLY\" = \"true\" ]; then",
          "                zypper -n patch --category security $exclude_opts",
          "            else",
          "                zypper -n update $exclude_opts",
          "            fi",
          "            ;;",
          "    esac",
          "}",
          "",
          "# Main execution",
          "update_package_cache",
          "",
          "if [ \"$OPERATION\" = \"Scan\" ]; then",
          "    log \"Performing scan operation - listing available updates\"",
          "    list_updates",
          "else",
          "    log \"Performing install operation\"",
          "    ",
          "    # List updates before installation",
          "    list_updates",
          "    ",
          "    # Install updates",
          "    install_updates",
          "    ",
          "    log \"Update installation completed\"",
          "fi",
          "",
          "# Check if reboot is required",
          "check_reboot_required() {",
          "    reboot_required=false",
          "    ",
          "    # Check common reboot indicators",
          "    if [ -f /var/run/reboot-required ]; then",
          "        reboot_required=true",
          "        log \"Reboot required flag found: /var/run/reboot-required\"",
          "    fi",
          "    ",
          "    # Check for kernel updates",
          "    current_kernel=$(uname -r)",
          "    case $PKG_MANAGER in",
          "        \"yum\"|\"dnf\")",
          "            if rpm -q kernel | tail -1 | grep -v \"$current_kernel\" >/dev/null 2>&1; then",
          "                reboot_required=true",
          "                log \"New kernel installed, reboot required\"",
          "            fi",
          "            ;;",
          "        \"apt\")",
          "            if [ -f /var/run/reboot-required ]; then",
          "                reboot_required=true",
          "            fi",
          "            ;;",
          "        \"zypper\")",
          "            if zypper ps -s | grep -q \"reboot\"; then",
          "                reboot_required=true",
          "                log \"System services require reboot\"",
          "            fi",
          "            ;;",
          "    esac",
          "    ",
          "    if [ \"$reboot_required\" = \"true\" ]; then",
          "        log \"REBOOT REQUIRED after patching\"",
          "        echo \"REBOOT_REQUIRED=true\"",
          "    else",
          "        log \"No reboot required\"",
          "        echo \"REBOOT_REQUIRED=false\"",
          "    fi",
          "}",
          "",
          "check_reboot_required",
          "",
          "log \"Patch installation phase completed successfully\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "PostPatchValidation",
      "description": "Validate system state after patching",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Starting post-patch validation...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "log \"Post-patch validation initiated\"",
          "",
          "# Check system responsiveness",
          "log \"Testing system responsiveness...\"",
          "if ! timeout 10 ls /proc/loadavg > /dev/null 2>&1; then",
          "    log \"ERROR: System appears unresponsive after patching\"",
          "    exit 1",
          "fi",
          "",
          "# Check package manager status",
          "PKG_MANAGER=$(command -v yum >/dev/null 2>&1 && echo \"yum\" || command -v dnf >/dev/null 2>&1 && echo \"dnf\" || command -v apt-get >/dev/null 2>&1 && echo \"apt\" || command -v zypper >/dev/null 2>&1 && echo \"zypper\" || echo \"unknown\")",
          "",
          "case $PKG_MANAGER in",
          "    \"yum\"|\"dnf\")",
          "        log \"Checking for package manager errors...\"",
          "        if grep -i error /var/log/yum.log | tail -10 | grep -q \"$(date +%Y-%m-%d)\"; then",
          "            log \"WARNING: Recent errors found in yum.log\"",
          "            grep -i error /var/log/yum.log | tail -5",
          "        fi",
          "        ;;",
          "    \"apt\")",
          "        log \"Checking APT status...\"",
          "        if [ -f /var/log/apt/history.log ]; then",
          "            recent_apt=$(grep \"$(date +%Y-%m-%d)\" /var/log/apt/history.log | tail -5)",
          "            if [ -n \"$recent_apt\" ]; then",
          "                log \"Recent APT activity:\"",
          "                echo \"$recent_apt\"",
          "            fi",
          "        fi",
          "        ;;",
          "    \"zypper\")",
          "        log \"Checking zypper history...\"",
          "        zypper history | head -10",
          "        ;;",
          "esac",
          "",
          "# Check critical services status",
          "log \"Verifying critical services...\"",
          "critical_services=(\"sshd\" \"systemd-logind\" \"dbus\" \"NetworkManager\" \"systemd-resolved\")",
          "failed_services=()",
          "",
          "for service in \"${critical_services[@]}\"; do",
          "    if systemctl is-active --quiet \"$service\" 2>/dev/null; then",
          "        log \"Service $service is running\"",
          "    elif systemctl list-unit-files --type=service | grep -q \"^$service.service\"; then",
          "        log \"WARNING: Critical service $service is not running\"",
          "        failed_services+=(\"$service\")",
          "    fi",
          "done",
          "",
          "if [ ${#failed_services[@]} -gt 0 ]; then",
          "    log \"WARNING: ${#failed_services[@]} critical services are not running\"",
          "fi",
          "",
          "# Check network connectivity",
          "log \"Testing network connectivity...\"",
          "if ping -c 1 -W 5 8.8.8.8 >/dev/null 2>&1; then",
          "    log \"Network connectivity verified\"",
          "else",
          "    log \"WARNING: Network connectivity issues detected\"",
          "fi",
          "",
          "# Check disk space after patching",
          "log \"Checking disk space...\"",
          "df_output=$(df -h | grep -E '^/dev/')",
          "echo \"$df_output\"",
          "",
          "# Check for any services that failed to start",
          "log \"Checking for failed services...\"", 
          "failed_units=$(systemctl list-units --failed --no-legend | wc -l)",
          "if [ \"$failed_units\" -gt 0 ]; then",
          "    log \"WARNING: $failed_units failed systemd units detected\"",
          "    systemctl list-units --failed --no-legend",
          "else",
          "    log \"No failed systemd units\"",
          "fi",
          "",
          "# Check system load",
          "load_avg=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//')",
          "log \"Current system load: $load_avg\"",
          "",
          "# Check memory usage",
          "mem_info=$(free -h | grep Mem)",
          "log \"Memory status: $mem_info\"",
          "",
          "# Check for kernel messages/errors",
          "log \"Checking for recent kernel messages...\"",
          "recent_errors=$(dmesg -T | grep -i error | tail -5)",
          "if [ -n \"$recent_errors\" ]; then",
          "    log \"Recent kernel errors found:\"",
          "    echo \"$recent_errors\"",
          "else",
          "    log \"No recent kernel errors\"",
          "fi",
          "",
          "# Summary",
          "log \"Post-patch validation completed\"",
          "log \"System appears stable after patching\"",
          "",
          "echo \"VALIDATION_STATUS=PASSED\"",
          "echo \"FAILED_SERVICES=${#failed_services[@]}\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "RestartServices",
      "description": "Restart previously stopped services",
      "inputs": {
        "timeoutSeconds": "300",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Restarting services after patching...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "# Check if we have a list of stopped services",
          "if [ -f /tmp/stopped_services.txt ]; then",
          "    log \"Found list of stopped services, attempting to restart...\"",
          "    ",
          "    while IFS= read -r service_name; do",
          "        if [ -n \"$service_name\" ]; then",
          "            log \"Restarting service: $service_name\"",
          "            ",
          "            if systemctl start \"$service_name\"; then",
          "                # Wait for service to start",
          "                timeout=60",
          "                counter=0",
          "                while ! systemctl is-active --quiet \"$service_name\" 2>/dev/null && [ $counter -lt $timeout ]; do",
          "                    sleep 1",
          "                    counter=$((counter + 1))",
          "                done",
          "                ",
          "                if systemctl is-active --quiet \"$service_name\" 2>/dev/null; then",
          "                    log \"Service $service_name started successfully\"",
          "                else",
          "                    log \"ERROR: Service $service_name failed to start within timeout\"",
          "                    systemctl status \"$service_name\" --no-pager || true",
          "                fi",
          "            else",
          "                log \"ERROR: Failed to start service $service_name\"",
          "                systemctl status \"$service_name\" --no-pager || true",
          "            fi",
          "        fi",
          "    done < /tmp/stopped_services.txt",
          "    ",
          "    # Clean up the stopped services file",
          "    rm -f /tmp/stopped_services.txt",
          "    log \"Cleaned up stopped services list\"",
          "else",
          "    log \"No stopped services list found, checking configured services...\"",
          "    ",
          "    # Parse service names from parameter as fallback",
          "    IFS=',' read -ra SERVICES <<< \"{{ ServiceNames }}\"",
          "    ",
          "    for service_name in \"${SERVICES[@]}\"; do",
          "        # Trim whitespace",
          "        service_name=$(echo \"$service_name\" | xargs)",
          "        ",
          "        if [ -z \"$service_name\" ]; then",
          "            continue",
          "        fi",
          "        ",
          "        if systemctl list-unit-files --type=service | grep -q \"^$service_name.service\"; then",
          "            if ! systemctl is-active --quiet \"$service_name\" 2>/dev/null; then",
          "                log \"Starting service: $service_name\"",
          "                systemctl start \"$service_name\" || log \"WARNING: Failed to start $service_name\"",
          "            else",
          "                log \"Service $service_name is already running\"",
          "            fi",
          "        else",
          "            log \"Service $service_name not found\"",
          "        fi",
          "    done",
          "fi",
          "",
          "log \"Service restart operations completed\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "DisableMaintenanceMode",
      "description": "Disable maintenance mode",
      "inputs": {
        "timeoutSeconds": "120",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Disabling maintenance mode...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "MAINTENANCE_MODE=\"{{ MaintenanceMode }}\"",
          "",
          "if [ \"$MAINTENANCE_MODE\" = \"true\" ]; then",
          "    log \"Disabling maintenance mode...\"",
          "    ",
          "    # Remove maintenance mode file",
          "    if [ -f /tmp/maintenance_mode ]; then",
          "        rm -f /tmp/maintenance_mode",
          "        log \"Maintenance mode file removed\"",
          "    fi",
          "    ",
          "    # Remove maintenance pages from web directories",
          "    web_dirs=(\"/var/www/html\" \"/usr/share/nginx/html\" \"/var/www\")",
          "    for web_dir in \"${web_dirs[@]}\"; do",
          "        if [ -f \"$web_dir/maintenance.html\" ]; then",
          "            rm -f \"$web_dir/maintenance.html\"",
          "            log \"Maintenance page removed from $web_dir\"",
          "        fi",
          "    done",
          "    ",
          "    # Remove maintenance responder script",
          "    if [ -f /tmp/maintenance_responder.sh ]; then",
          "        rm -f /tmp/maintenance_responder.sh",
          "        log \"Maintenance responder script removed\"",
          "    fi",
          "    ",
          "    # Remove temporary maintenance HTML",
          "    if [ -f /tmp/maintenance.html ]; then",
          "        rm -f /tmp/maintenance.html",
          "        log \"Temporary maintenance HTML removed\"",
          "    fi",
          "    ",
          "    log \"Maintenance mode disabled successfully\"",
          "else",
          "    log \"Maintenance mode was not enabled\"",
          "fi",
          "",
          "echo \"MAINTENANCE_MODE_DISABLED=true\""
        ]
      }
    },
    {
      "action": "aws:runShellScript",
      "name": "GenerateReport",
      "description": "Generate patching report",
      "inputs": {
        "timeoutSeconds": "180",
        "runCommand": [
          "#!/bin/bash",
          "set -e",
          "",
          "echo \"Generating patching report...\"",
          "",
          "# Function to log with timestamp",
          "log() {",
          "    echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $1\"",
          "}",
          "",
          "# Collect system information",
          "HOSTNAME=$(hostname)",
          "KERNEL_VERSION=$(uname -r)",
          "OS_INFO=$(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"' || echo \"Unknown\")",
          "UPTIME=$(uptime -p || echo \"Unknown\")",
          "LOAD_AVG=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//' || echo \"Unknown\")",
          "",
          "# Check reboot status",
          "REBOOT_REQUIRED=\"false\"",
          "if [ -f /var/run/reboot-required ]; then",
          "    REBOOT_REQUIRED=\"true\"",
          "fi",
          "",
          "# Count running services",
          "SERVICES_RUNNING=$(systemctl list-units --type=service --state=running --no-legend | wc -l)",
          "SERVICES_FAILED=$(systemctl list-units --type=service --state=failed --no-legend | wc -l)",
          "",
          "# Detect package manager and count updates",
          "PKG_MANAGER=\"unknown\"",
          "UPDATES_INSTALLED=\"0\"",
          "",
          "if command -v yum >/dev/null 2>&1; then",
          "    PKG_MANAGER=\"yum\"",
          "elif command -v dnf >/dev/null 2>&1; then",
          "    PKG_MANAGER=\"dnf\"",
          "elif command -v apt-get >/dev/null 2>&1; then",
          "    PKG_MANAGER=\"apt\"",
          "elif command -v zypper >/dev/null 2>&1; then",
          "    PKG_MANAGER=\"zypper\"",
          "fi",
          "",
          "# Try to count today's updates",
          "TODAY=$(date +%Y-%m-%d)",
          "case $PKG_MANAGER in",
          "    \"yum\"|\"dnf\")",
          "        if [ -f /var/log/yum.log ]; then",
          "            UPDATES_INSTALLED=$(grep \"$TODAY\" /var/log/yum.log | grep -c \"Installed:\" || echo \"0\")",
          "        fi",
          "        ;;",
          "    \"apt\")",
          "        if [ -f /var/log/apt/history.log ]; then",
          "            UPDATES_INSTALLED=$(grep \"$TODAY\" /var/log/apt/history.log | grep -c \"Install:\" || echo \"0\")",
          "        fi",
          "        ;;",
          "esac",
          "",
          "# Generate JSON report",
          "cat << EOF",
          "PATCHING_REPORT_START",
          "{",
          "  \"hostname\": \"$HOSTNAME\",",
          "  \"patching_date\": \"$(date -Iseconds)\",",
          "  \"operation\": \"{{ Operation }}\",",
          "  \"reboot_option\": \"{{ RebootOption }}\",",
          "  \"security_only\": \"{{ SecurityUpdatesOnly }}\",",
          "  \"os_info\": \"$OS_INFO\",",
          "  \"kernel_version\": \"$KERNEL_VERSION\",",
          "  \"package_manager\": \"$PKG_MANAGER\",",
          "  \"reboot_required\": $REBOOT_REQUIRED,",
          "  \"updates_installed\": $UPDATES_INSTALLED,",
          "  \"services_running\": $SERVICES_RUNNING,",
          "  \"services_failed\": $SERVICES_FAILED,",
          "  \"system_load\": \"$LOAD_AVG\",",
          "  \"uptime\": \"$UPTIME\",",
          "  \"maintenance_mode_used\": \"{{ MaintenanceMode }}\",",
          "  \"patch_status\": \"completed\"",
          "}",
          "PATCHING_REPORT_END",
          "EOF",
          "",
          "log \"Patching report generated successfully\"",
          "log \"Summary: $UPDATES_INSTALLED updates processed, Reboot required: $REBOOT_REQUIRED\"",
          "log \"Services: $SERVICES_RUNNING running, $SERVICES_FAILED failed\"",
          "",
          "echo \"REPORT_GENERATED=true\""
        ]
      }
    }
  ]
}