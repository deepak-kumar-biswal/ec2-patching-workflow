{
  "comment": "Windows-only patching across multiple regions",
  "executionName": "windows-multi-region",
  "accountWaves": [
    {
      "name": "windows-regional-wave",
      "accounts": ["111111111111", "222222222222"],
      "regions": ["us-east-1", "us-west-2"]
    }
  ],
  "ec2": {
    "tagKey": "PatchGroup", 
    "tagValue": "win"
  },
  "preCollect": {
    "enabled": true
  },
  "customDocuments": {
    "windowsPrePatch": "WindowsPrePatch",
    "windowsPatch": "WindowsPatch",
    "windowsPostPatch": "WindowsPostPatch",
    "linuxPrePatch": "LinuxPrePatch",
    "linuxPatch": "LinuxPatch",
    "linuxPostPatch": "LinuxPostPatch"
  },
  "abortOnIssues": false
}
