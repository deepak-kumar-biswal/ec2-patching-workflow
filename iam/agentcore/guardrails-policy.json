{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockGuardrailsManagement",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateGuardrail",
        "bedrock:GetGuardrail",
        "bedrock:UpdateGuardrail",
        "bedrock:DeleteGuardrail",
        "bedrock:ListGuardrails",
        "bedrock:CreateGuardrailVersion",
        "bedrock:GetGuardrailVersion",
        "bedrock:ListGuardrailVersions"
      ],
      "Resource": [
        "arn:aws:bedrock:*:${AWS::AccountId}:guardrail/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "AgentCore:Application",
            "AgentCore:Environment",
            "AgentCore:GuardrailId"
          ]
        }
      }
    },
    {
      "Sid": "BedrockGuardrailApply",
      "Effect": "Allow",
      "Action": [
        "bedrock:ApplyGuardrail"
      ],
      "Resource": [
        "arn:aws:bedrock:*:${AWS::AccountId}:guardrail/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "BedrockGuardrailAssociation",
      "Effect": "Allow",
      "Action": [
        "bedrock:UpdateAgent"
      ],
      "Resource": [
        "arn:aws:bedrock:*:${AWS::AccountId}:agent/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        },
        "ArnLike": {
          "bedrock:GuardrailArn": "arn:aws:bedrock:*:${AWS::AccountId}:guardrail/*"
        }
      }
    },
    {
      "Sid": "BedrockEvaluationJobs",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateEvaluationJob",
        "bedrock:GetEvaluationJob",
        "bedrock:ListEvaluationJobs",
        "bedrock:StopEvaluationJob"
      ],
      "Resource": [
        "arn:aws:bedrock:*:${AWS::AccountId}:evaluation-job/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "BedrockModelEvaluationDatasets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::agentcore-*-evaluation-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "ContentFilteringLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:${AWS::AccountId}:log-group:/aws/bedrock/guardrails/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    }
  ]
}
