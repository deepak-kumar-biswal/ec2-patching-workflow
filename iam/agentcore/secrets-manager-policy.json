{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsManagerReadSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:${AWS::AccountId}:secret:agentcore/*",
        "arn:aws:secretsmanager:*:${AWS::AccountId}:secret:AgentCore/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}",
          "secretsmanager:ResourceTag/AgentCore:SecretType": [
            "api-key",
            "connection-string",
            "oauth-token"
          ]
        },
        "ForAllValues:StringEquals": {
          "secretsmanager:VersionStage": [
            "AWSCURRENT"
          ]
        }
      }
    },
    {
      "Sid": "SecretsManagerListSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "secretsmanager:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "SecretsManagerRotation",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:RotateSecret",
        "secretsmanager:GetRandomPassword"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:${AWS::AccountId}:secret:agentcore/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        },
        "Bool": {
          "secretsmanager:RotationEnabled": "true"
        }
      }
    },
    {
      "Sid": "SecretsManagerKMSDecrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:*:${AWS::AccountId}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.*.amazonaws.com",
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "ParameterStoreReadAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:*:${AWS::AccountId}:parameter/agentcore/*",
        "arn:aws:ssm:*:${AWS::AccountId}:parameter/AgentCore/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/AgentCore:Application": "${aws:PrincipalTag/Application}"
        }
      }
    },
    {
      "Sid": "DenyPlaintextSecretAccess",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "secretsmanager:ResourceTag/AgentCore:EncryptionType": "KMS"
        }
      }
    }
  ]
}
